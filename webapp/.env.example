# Configuration Django pour CartoVec
# Copie ce fichier en `.env` dans le dossier webapp/ et adapte aux valeurs locales.
# Le `.env` est ignore par git (voir .gitignore).

# ----------------------------------------------------------------------
# Django
# ----------------------------------------------------------------------
# Genere une cle secrete : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-moi-en-prod-0123456789abcdef0123456789abcdef

# True en developpement, False en production
DEBUG=True

# Hosts autorises (separes par virgule)
ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------------------
# GDAL / GEOS — Windows seulement
# Sur Windows il faut indiquer le dossier ou se trouvent gdal.dll et geos_c.dll.
# C'est le sous-dossier Library/bin/ de ton env conda.
#
# Exemples typiques :
#   C:\Users\<TON_NOM>\anaconda3\envs\pfa
#   C:\Users\<TON_NOM>\miniconda3\envs\pfa
#   C:\ProgramData\anaconda3\envs\pfa
#
# Sur Linux / macOS / Colab : tu peux laisser vide, les libs systeme sont trouvees automatiquement.
# ----------------------------------------------------------------------
CONDA_ENV_PATH=C:\Users\ochou\anaconda3\envs\pfa

# ----------------------------------------------------------------------
# Base de donnees (V1 = SQLite, V2 = PostgreSQL+PostGIS)
# ----------------------------------------------------------------------
# Decommente et adapte si tu passes a Postgres :
# DATABASE_URL=postgres://user:password@localhost:5432/cartovec

# ----------------------------------------------------------------------
# Pipeline
# ----------------------------------------------------------------------
# Resolution maximale pour le pretraitement (px). Reduit si OOM.
PIPELINE_MAX_DIMENSION=2400

# Marge de filtrage des features pres du bord (px).
PIPELINE_FILTER_MARGIN=20
